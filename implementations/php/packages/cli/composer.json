{
    "name": "superheld/summae-cli",
    "description": "CLI for summae-core — JSON output, persistent workspace (SQLite via the database adapter)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/superheld/summae",
    "keywords": ["accounting", "cli", "rechnungswesen", "doppik", "gobd"],
    "support": {
        "issues": "https://github.com/superheld/summae/issues",
        "source": "https://github.com/superheld/summae"
    },
    "require": {
        "php": ">=8.3",
        "superheld/summae-core": "self.version",
        "symfony/console": "^7.0",
        "superheld/summae-laravel": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Summae\\Cli\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.17.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/summae"
    ]
}
