<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
        <testsuite name="cli">
            <directory>packages/cli/tests</directory>
        </testsuite>
        <testsuite name="runner">
            <directory>runner/tests</directory>
        </testsuite>
    </testsuites>
    <!-- The coverage gate measures every package that has tests, each with its own floor
         (runner/bin/coverage-gate.php). packages/laravel joined on 2026-08-16 (IMPL-015): it now
         has a suite of its own, so its number is something a test asserts rather than a side
         effect of other suites. -->
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/cli/src</directory>
            <directory>packages/laravel/src</directory>
            <directory>runner/src</directory>
        </include>
    </source>
</phpunit>
