<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
        <testsuite name="cli">
            <directory>packages/cli/tests</directory>
        </testsuite>
        <testsuite name="runner">
            <directory>runner/tests</directory>
        </testsuite>
    </testsuites>
    <!-- The coverage gate measures every package that has tests, each with its own floor
         (runner/bin/coverage-gate.php). packages/laravel is deliberately absent: it has no
         tests of its own (packages/laravel/tests/ holds nothing but a .gitkeep), so any
         number it produced would be a side effect of other suites. Known gap, recorded as
         NF-015 in SPEC-FINDINGS.md — to be closed by writing tests, not by measuring it. -->
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/cli/src</directory>
            <directory>runner/src</directory>
        </include>
    </source>
</phpunit>
