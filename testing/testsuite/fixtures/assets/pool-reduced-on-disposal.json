{
  "fixture": "pool-reduced-on-disposal",
  "description": "Die Gegenprobe zu `pool-unaffected-by-disposal`: dasselbe Wirtschaftsgut, derselbe Ablauf, nur sagt das Regelmodul hier `poolReducedOnDisposal: true` — und der Abgang schreibt den Restbuchwert aus, statt den Pool weiterlaufen zu lassen. Zwei Pakete, zwei Antworten, ein Kern. Genau das ist der Punkt: „der Sammelposten wird durch einen Abgang nicht vermindert\" ist keine Eigenschaft des Poolens, sondern die Antwort einer Jurisdiktion (Deutschland, § 6 Abs. 2a EStG); UK und Australien entnehmen Abgänge ihren Pools. Stünde die Regel im Kern, erbte jede andere Jurisdiktion sie stillschweigend — derselbe Fehler, den SPEC-004 für die Pool-Dauer behoben hat.",
  "covers": ["F-AST-006", "F-PACK-POLICY-001"],
  "setup": {
    "tenant": { "name": "Pool-Abgang Ltd", "baseCurrency": "EUR" },
    "accounts": [
      { "number": "0480", "name": "Sammelposten", "type": "asset", "subtype": "fixed_asset" },
      { "number": "1200", "name": "Bank", "type": "asset", "subtype": "bank" },
      { "number": "4900", "name": "Erlöse aus Anlagenabgang", "type": "revenue" },
      { "number": "6500", "name": "Abschreibungen", "type": "expense" },
      { "number": "6510", "name": "GWG-Aufwand", "type": "expense" },
      { "number": "6900", "name": "Verlust aus Anlagenabgang", "type": "expense" }
    ],
    "ruleModule": {
      "gwgThresholds": [
        { "validFrom": "2018-01-01", "validTo": null, "immediateMax": "250.00", "poolMin": "250.01", "poolMax": "1000.00", "poolYears": 3, "poolReducedOnDisposal": true }
      ],
      "usefulLife": [ { "assetClass": "it-hardware", "months": 36 } ],
      "assetAccounts": {
        "acquisitionCounterAccount": "1200",
        "depreciationExpenseAccount": "6500",
        "gwgExpenseAccount": "6510",
        "disposalProceedsAccount": "4900",
        "disposalLossAccount": "6900"
      }
    },
    "fiscalYears": [
      { "year": 2026, "start": "2026-01-01", "end": "2026-12-31" },
      { "year": 2027, "start": "2027-01-01", "end": "2027-12-31" }
    ],
    "vouchers": [
      { "id": "$V1", "voucherNumber": "ER-POOL", "voucherDate": "2026-01-01" },
      { "id": "$V2", "voucherNumber": "ABGANG-2027", "voucherDate": "2027-01-02" }
    ]
  },
  "steps": [
    {
      "op": "acquireAsset",
      "input": {
        "name": "Bürostuhl-Charge", "assetClass": "it-hardware", "assetAccount": "0480",
        "acquisitionCost": { "amount": "900.00", "currency": "EUR" },
        "acquiredOn": "2026-01-01", "voucherId": "$V1", "gwgChoice": "auto"
      },
      "expect": { "result": { "id": "$A1", "route": "pool", "usefulLifeMonths": 36 } }
    },
    {
      "op": "runDepreciation",
      "input": { "fiscalYear": 2026 },
      "expect": {
        "comment": "Erstes Jahr wie im Zwillings-Fixture: 300,00 von 900,00.",
        "result": { "entriesCreated": 1, "totalDepreciation": { "amount": "300.00", "currency": "EUR" } }
      }
    },
    {
      "op": "disposeAsset",
      "input": { "assetId": "$A1", "disposedOn": "2027-01-02", "voucherId": "$V2", "proceeds": { "amount": "100.00", "currency": "EUR" }, "proceedsAccount": "4900" },
      "expect": {
        "comment": "Hier trennen sich die beiden Fixtures: weil das Pack den Pool bei Abgang vermindert, wird das Gut wie jedes andere behandelt — Restbuchwert 900,00 − 300,00 = 600,00 vom Sammelposten ausgebucht, 100,00 Erlös vereinnahmt, die Differenz von 500,00 als Verlust. Im Zwillings-Fixture passiert davon nichts.",
        "result": { "id": "$A1", "status": "disposed" }
      }
    },
    {
      "op": "runDepreciation",
      "input": { "fiscalYear": 2027 },
      "expect": {
        "comment": "Und deshalb läuft 2027 auch nichts mehr: der Posten ist weg. Im Zwillings-Fixture schreibt der Pool hier sein zweites Drittel ab.",
        "result": { "alreadyRun": true, "entriesCreated": 0 }
      }
    }
  ],
  "projections": [
    {
      "name": "trialBalance",
      "params": { "fiscalYear": 2027, "throughPeriod": 12 },
      "expect": {
        "comment": "Sammelposten auf 0,00 statt auf 300,00 Restwert — dieselbe Buchungsfolge, andere Pack-Antwort.",
        "rows": [
          { "account": "0480", "openingBalance": "600.00", "creditTotal": "600.00", "balance": "0.00" },
          { "account": "1200", "openingBalance": "-900.00", "debitTotal": "100.00", "balance": "-800.00" },
          { "account": "6900", "openingBalance": "0.00", "debitTotal": "500.00", "balance": "500.00" }
        ]
      }
    }
  ]
}
