{
  "fixture": "pool-unaffected-by-disposal",
  "description": "F-AST-006: der Sammelposten wird jahrgangsbezogen starr aufgelöst — unbeeinflusst davon, ob die einzelnen Wirtschaftsgüter noch da sind — **weil das Pack es so sagt** (`poolReducedOnDisposal: false`). Die Regel steht nicht im Kern: Deutschland vermindert den Sammelposten nicht (§ 6 Abs. 2a EStG), UK und Australien entnehmen Abgänge ihren Pools. Gegenprobe mit der anderen Antwort: `pool-reduced-on-disposal`. Scheidet eines aus, läuft die AfA unverändert bis zum Ende der Laufzeit weiter; der Posten wird nicht vermindert (die Jurisdiktion, die diese Regel bekannt gemacht hat, schreibt es wörtlich so). Vorher brach die AfA beim Abgang ab: für jedes Restjahr zu wenig Abschreibung und ein zu hoher Gewinn, ohne dass irgendetwas rot wurde. Gegenprobe zum Kapitalisierungs-Fall im selben Fixture — dort ist der Abbruch richtig.",
  "covers": [
    "F-AST-006",
    "F-AST-003"
  ],
  "setup": {
    "tenant": {
      "name": "Pool GmbH",
      "baseCurrency": "EUR"
    },
    "accounts": [
      {
        "number": "0480",
        "name": "Sammelposten",
        "type": "asset",
        "subtype": "fixed_asset"
      },
      {
        "number": "0500",
        "name": "Maschinen",
        "type": "asset",
        "subtype": "fixed_asset"
      },
      {
        "number": "1200",
        "name": "Bank",
        "type": "asset",
        "subtype": "bank"
      },
      {
        "number": "4900",
        "name": "Erlöse aus Anlagenabgang",
        "type": "revenue"
      },
      {
        "number": "6500",
        "name": "Abschreibungen",
        "type": "expense"
      },
      {
        "number": "6510",
        "name": "GWG-Aufwand",
        "type": "expense"
      },
      {
        "number": "6900",
        "name": "Verlust aus Anlagenabgang",
        "type": "expense"
      }
    ],
    "ruleModule": {
      "gwgThresholds": [
        {
          "validFrom": "2018-01-01",
          "validTo": null,
          "immediateMax": "250.00",
          "poolMin": "250.01",
          "poolMax": "1000.00",
          "poolYears": 3,
          "poolReducedOnDisposal": false
        }
      ],
      "usefulLife": [
        {
          "assetClass": "it-hardware",
          "months": 36
        },
        {
          "assetClass": "machinery",
          "months": 36
        }
      ],
      "assetAccounts": {
        "acquisitionCounterAccount": "1200",
        "depreciationExpenseAccount": "6500",
        "gwgExpenseAccount": "6510",
        "disposalProceedsAccount": "4900",
        "disposalLossAccount": "6900"
      }
    },
    "fiscalYears": [
      {
        "year": 2026,
        "start": "2026-01-01",
        "end": "2026-12-31"
      },
      {
        "year": 2027,
        "start": "2027-01-01",
        "end": "2027-12-31"
      }
    ],
    "vouchers": [
      {
        "id": "$V1",
        "voucherNumber": "ER-POOL",
        "voucherDate": "2026-01-01"
      },
      {
        "id": "$V2",
        "voucherNumber": "ER-MASCHINE",
        "voucherDate": "2026-01-01"
      },
      {
        "id": "$V3",
        "voucherNumber": "ABGANG-2027",
        "voucherDate": "2027-01-02"
      }
    ]
  },
  "steps": [
    {
      "op": "acquireAsset",
      "input": {
        "name": "Bürostuhl-Charge",
        "assetClass": "it-hardware",
        "assetAccount": "0480",
        "acquisitionCost": {
          "amount": "900.00",
          "currency": "EUR"
        },
        "acquiredOn": "2026-01-01",
        "voucherId": "$V1",
        "gwgChoice": "auto"
      },
      "expect": {
        "comment": "900,00 liegt zwischen poolMin und poolMax → Pool-Weiche, Plan = poolYears × 12 = 36 Monate, also 300,00 im Jahr. Anschaffung am 1. Januar, damit die monatsgenaue Verteilung das Ergebnis nicht überlagert.",
        "result": {
          "id": "$A1",
          "route": "pool",
          "usefulLifeMonths": 36
        }
      }
    },
    {
      "op": "acquireAsset",
      "input": {
        "name": "Maschine",
        "assetClass": "machinery",
        "assetAccount": "0500",
        "acquisitionCost": {
          "amount": "3600.00",
          "currency": "EUR"
        },
        "acquiredOn": "2026-01-01",
        "voucherId": "$V2",
        "usefulLifeMonths": 36
      },
      "expect": {
        "comment": "Gegenprobe: oberhalb der Pool-Grenze, also normal aktiviert — 1200,00 im Jahr.",
        "result": {
          "id": "$A2",
          "route": "capitalize",
          "usefulLifeMonths": 36
        }
      }
    },
    {
      "op": "runDepreciation",
      "input": {
        "fiscalYear": 2026
      },
      "expect": {
        "comment": "Erstes Jahr, beide Güter vorhanden: 300,00 Pool + 1200,00 Maschine.",
        "result": {
          "entriesCreated": 2,
          "totalDepreciation": {
            "amount": "1500.00",
            "currency": "EUR"
          }
        }
      }
    },
    {
      "op": "disposeAsset",
      "input": {
        "assetId": "$A1",
        "disposedOn": "2027-01-02",
        "voucherId": "$V3",
        "proceeds": {
          "amount": "100.00",
          "currency": "EUR"
        },
        "proceedsAccount": "4900"
      },
      "expect": {
        "comment": "Die Charge wird verschrottet und bringt 100,00 Schrotterlös. Abgang bewusst NACH dem AfA-Lauf: `bookValueAt` liest den gebuchten Stand, und der Jahreslauf bucht per 31.12. Wer mitten im Jahr abgeht, ohne die anteilige AfA vorher zu buchen, bucht einen zu hohen Restwert aus — die AfA bis zum Abgangsmonat holt `dispose` nicht selbst nach (Befund IMPL-022).",
        "result": {
          "id": "$A1",
          "status": "disposed"
        }
      }
    },
    {
      "op": "disposeAsset",
      "input": {
        "assetId": "$A2",
        "disposedOn": "2027-01-02",
        "voucherId": "$V3"
      },
      "expect": {
        "comment": "Die Maschine geht ohne Erlös ab: Restbuchwert 3600,00 − 1200,00 = 2400,00 wird vom Anlagekonto ausgebucht und landet als Verlust auf 6900. Vor dem IMPL-021-Fix passierte hier gar nichts — die Maschine stand danach weiter mit 2400,00 in der Bilanz.",
        "result": {
          "id": "$A2",
          "status": "disposed"
        }
      }
    },
    {
      "op": "runDepreciation",
      "input": {
        "fiscalYear": 2027
      },
      "expect": {
        "comment": "Der Kern des Befunds: im Folgejahr läuft allein der Pool weiter — 300,00, das zweite von drei Jahresfünfteln, obwohl das Gut längst weg ist. Die Maschine liefert nichts mehr. Vor dem Fix waren es 0 Buchungen und `alreadyRun: true`, also drei Jahre lang zu wenig Aufwand.",
        "result": {
          "entriesCreated": 1,
          "totalDepreciation": {
            "amount": "300.00",
            "currency": "EUR"
          }
        }
      }
    }
  ],
  "projections": [
    {
      "name": "trialBalance",
      "params": {
        "fiscalYear": 2027,
        "throughPeriod": 12
      },
      "expect": {
        "comment": "Sammelposten nach zwei von drei Jahren: 900,00 − 300,00 − 300,00 = 300,00 — der Pool bleibt trotz Abgang stehen und schreibt weiter ab (F-AST-006). Die Maschine dagegen ist mit ihrem Restbuchwert vom Konto verschwunden (F-AST-004): 0500 steht auf 0,00 und taucht deshalb gar nicht mehr auf. Bank trägt die Anschaffungen vor und bekommt den Schrotterlös; 4900 führt den Gewinn aus dem Pool-Abgang, 6900 den Verlust aus der Maschine.",
        "rows": [
          {
            "account": "0480",
