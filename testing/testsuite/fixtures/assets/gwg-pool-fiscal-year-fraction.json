        "depreciationExpenseAccount": "4830",
        "gwgExpenseAccount": "4855"
      }
    }
  },
  "steps": [
    {
      "op": "acquireAsset",
      "input": {
        "name": "Werkstattregale",
        "assetClass": "it-hardware",
        "assetAccount": "0480",
