        "year": 2026,
        "start": "2026-01-01",
        "end": "2026-12-31"
      },
      {
        "year": 2027,
        "start": "2027-01-01",
        "end": "2027-12-31"
      },
      {
        "year": 2028,
        "start": "2028-01-01",
