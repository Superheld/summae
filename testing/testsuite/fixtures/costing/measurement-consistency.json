{
  "fixture": "measurement-consistency",
  "description": "Consistency of measurement methods, § 252 Abs. 1 Nr. 6 HGB. A released costing run has always frozen the basis it was computed under — every configured component with the pack's treatment and whether it went in — on the stated ground that a released run which answers differently tomorrow is not released. What did not exist was anybody comparing two of those records: productionCost.include lives in the tenant configuration and could be changed between two runs, and no question you could ask would have told you. Here 2026 is valued with the administration option elected and 2027 without it, on identical books, so the same 84,000.00 of cost yields 80,000.00 of production cost in one year and 70,000.00 in the next, while the 4,000.00 of research stays out of both because the pack forbids it. The projection reports the change with its two runs, what was removed, and acrossFiscalYears — the one distinction the norm itself draws, because within a year a changed basis is a correction the year still absorbs while across a boundary it is the case the provision is written about. It REPORTS and does not refuse, and the reason is legal rather than architectural: § 252 Abs. 2 permits deviation in justified exceptional cases, so a rule that rejected a changed election would be wrong rather than merely strict, and whether a deviation is justified is a judgement about the business. Same line vatReturn.gapWarnings and duplicateVouchers already draw. Three further things are pinned. Mandatory components are not reported as elected: a pack that promotes a component from optional to mandatory must not read as the tenant having changed its mind. A released run configured with no production cost at all lands in withoutBasis rather than being dropped — a reader comparing two years needs to know the second measured nothing rather than measured the same, because an omission that is not stated reads as agreement. And electing a component for which no base is configured is now E_INPUT_INVALID: it used to pass every check and then do nothing, which is the worst possible outcome here, since the consistency report would have shown the basis as unchanged — true, and useless.",
  "covers": ["F-CORE-049"],
  "setup": {
    "tenant": { "name": "Fixture GmbH", "baseCurrency": "EUR" },
    "accounts": [
      { "number": "1200", "name": "Bank", "type": "asset", "subtype": "bank" },
      { "number": "4000", "name": "Fertigungsmaterial", "type": "expense" },
      { "number": "4120", "name": "Gehälter", "type": "expense" },
      { "number": "4900", "name": "Forschung", "type": "expense" }
    ],
    "fiscalYears": [
      { "year": 2026, "start": "2026-01-01", "end": "2026-12-31" },
      { "year": 2027, "start": "2027-01-01", "end": "2027-12-31" }
    ],
    "vouchers": [
      { "id": "$V1", "voucherNumber": "KOST-2026-01", "voucherDate": "2026-01-31" },
      { "id": "$V2", "voucherNumber": "KOST-2027-01", "voucherDate": "2027-01-31" }
    ],
    "dimensionTypes": [ { "code": "costCenter", "name": "Kostenstelle" } ],
    "dimensionValues": [
      { "typeCode": "costCenter", "code": "FERT", "name": "Fertigungsstelle" },
      { "typeCode": "costCenter", "code": "VW", "name": "Verwaltung" }
    ],
    "ruleModule": {
      "productionCost": {
        "treatments": [
          { "component": "materialDirect", "treatment": "mandatory" },
          { "component": "productionOverhead", "treatment": "mandatory" },
          { "component": "administration", "treatment": "optional" },
          { "component": "research", "treatment": "forbidden" }
        ]
      }
    }
  },
  "steps": [
    {
      "op": "post",
      "input": {
        "entryDate": "2026-01-31", "voucherId": "$V1", "text": "Kosten Januar 2026",
        "lines": [
          { "account": "4000", "side": "debit", "money": { "amount": "50000.00", "currency": "EUR" } },
          { "account": "4120", "side": "debit", "money": { "amount": "20000.00", "currency": "EUR" },
            "dimensions": [ { "type": "costCenter", "code": "FERT" } ] },
          { "account": "4120", "side": "debit", "money": { "amount": "10000.00", "currency": "EUR" },
            "dimensions": [ { "type": "costCenter", "code": "VW" } ] },
          { "account": "4900", "side": "debit", "money": { "amount": "4000.00", "currency": "EUR" } },
          { "account": "1200", "side": "credit", "money": { "amount": "84000.00", "currency": "EUR" } }
        ]
      },
      "expect": { "result": { "sequenceNumber": 1 } }
    },
    {
      "op": "post",
      "input": {
        "entryDate": "2027-01-31", "voucherId": "$V2", "text": "Kosten Januar 2027",
        "lines": [
          { "account": "4000", "side": "debit", "money": { "amount": "50000.00", "currency": "EUR" } },
          { "account": "4120", "side": "debit", "money": { "amount": "20000.00", "currency": "EUR" },
            "dimensions": [ { "type": "costCenter", "code": "FERT" } ] },
          { "account": "4120", "side": "debit", "money": { "amount": "10000.00", "currency": "EUR" },
            "dimensions": [ { "type": "costCenter", "code": "VW" } ] },
          { "account": "4900", "side": "debit", "money": { "amount": "4000.00", "currency": "EUR" } },
          { "account": "1200", "side": "credit", "money": { "amount": "84000.00", "currency": "EUR" } }
        ]
