      "expect": { "result": { "runId": "$R2", "status": "draft", "version": 1 } }
    },
    {
      "op": "releaseCosting",
      "input": { "runId": "$R2" },
      "expect": { "result": { "status": "released" } }
    },
    {
      "op": "setAllocationScheme",
      "input": { "steps": [] },
