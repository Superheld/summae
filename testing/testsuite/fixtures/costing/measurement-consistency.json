        "result": { "valid": true, "productionCostComponents": 0 }
      }
    },
    {
      "op": "runCosting",
      "input": { "fiscalYear": 2027, "period": 2 },
      "expect": { "result": { "runId": "$R3", "status": "draft", "version": 1 } }
    },
    {
      "op": "releaseCosting",
      "input": { "runId": "$R3" },
      "expect": { "result": { "status": "released" } }
    }
  ],
  "projections": [
