          "include": [],
          "components": [
            { "id": "materialDirect", "base": { "accounts": ["4000"] } },
            { "id": "productionOverhead", "base": { "costCenters": ["FERT"] } },
            { "id": "administration", "base": { "costCenters": ["VW"] } },
            { "id": "research", "base": { "accounts": ["4900"] } }
          ]
        }
      },
      "expect": {
