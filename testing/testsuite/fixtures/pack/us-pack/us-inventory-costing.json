{
  "fixture": "us-inventory-costing",
  "description": "US pack: inventory costing under ASC 330, driving the SAME books as `de-herstellungskosten` so that the difference is visible and has exactly one cause. Both jurisdictions require full absorption of production cost — direct material, direct labor, production overhead including the depreciation of production facilities. They part company on general and administrative expense: § 255 Abs. 2 Satz 4 HGB leaves it to the preparer, ASC 330-10-30-8 makes it a period charge. So the identical 132,000.00 of cost yields 126,000.00 of inventory value in Germany and 114,000.00 here — a 12,000.00 difference produced entirely by one row of pack data, with no branch anywhere in the core. The second half of the fixture is the refusal: electing `administration` is E_INPUT_INVALID rather than a quiet exclusion, because the caller has asserted something about their books that this jurisdiction does not allow, and silently dropping it would leave them believing a figure they never got.",
  "covers": ["F-KLR-004", "F-KLR-005", "SF-12"],
  "setup": {},
  "steps": [
    {
      "op": "createTenant",
      "input": { "name": "Manufacturing Inc", "baseCurrency": "USD", "pack": "us", "firstFiscalYear": 2026 },
      "expect": { "result": { "id": "$T1", "pack": { "id": "us" } } }
    },
    {
      "op": "defineDimensionType",
      "input": { "tenant": "$T1", "code": "costCenter" },
      "expect": { "result": { "code": "costCenter" } }
    },
    { "op": "defineDimensionValue", "input": { "tenant": "$T1", "type": "costCenter", "code": "MAT" }, "expect": { "result": { "code": "MAT" } } },
    { "op": "defineDimensionValue", "input": { "tenant": "$T1", "type": "costCenter", "code": "FERT" }, "expect": { "result": { "code": "FERT" } } },
    { "op": "defineDimensionValue", "input": { "tenant": "$T1", "type": "costCenter", "code": "VW" }, "expect": { "result": { "code": "VW" } } },
    { "op": "defineDimensionValue", "input": { "tenant": "$T1", "type": "costCenter", "code": "VT" }, "expect": { "result": { "code": "VT" } } },
    {
      "op": "createVoucher",
      "input": { "tenant": "$T1", "voucher": { "voucherNumber": "COST-2026-01", "voucherDate": "2026-01-31" } },
      "expect": { "result": { "id": "$V1" } }
    },
    {
      "op": "post",
      "input": {
        "tenant": "$T1", "entryDate": "2026-01-31", "voucherId": "$V1", "text": "January costs",
        "lines": [
          { "account": "5000", "side": "debit", "money": { "amount": "50000.00", "currency": "USD" } },
          { "account": "6100", "side": "debit", "money": { "amount": "30000.00", "currency": "USD" } },
          { "account": "6300", "side": "debit", "money": { "amount": "8000.00", "currency": "USD" } },
          { "account": "6000", "side": "debit", "money": { "amount": "5000.00", "currency": "USD" },
            "dimensions": [ { "type": "costCenter", "code": "MAT" } ] },
          { "account": "6000", "side": "debit", "money": { "amount": "21000.00", "currency": "USD" },
            "dimensions": [ { "type": "costCenter", "code": "FERT" } ] },
          { "account": "6000", "side": "debit", "money": { "amount": "12000.00", "currency": "USD" },
            "dimensions": [ { "type": "costCenter", "code": "VW" } ] },
          { "account": "6000", "side": "debit", "money": { "amount": "6000.00", "currency": "USD" },
            "dimensions": [ { "type": "costCenter", "code": "VT" } ] },
          { "account": "1010", "side": "credit", "money": { "amount": "132000.00", "currency": "USD" } }
        ]
      },
      "expect": { "result": { "sequenceNumber": 1 } }
    },
    {
      "op": "setAllocationScheme",
      "input": {
        "tenant": "$T1",
        "steps": [],
        "productionCost": {
          "include": ["administration"],
          "components": [ { "id": "administration", "base": { "costCenters": ["VW"] } } ]
        }
      },
      "expect": {
        "comment": "In Deutschland ein Wahlrecht, hier Periodenaufwand — dieselbe Eingabe, andere Antwort, und die steht im Pack",
        "error": "E_INPUT_INVALID"
      }
    },
    {
      "op": "setAllocationScheme",
      "input": {
        "tenant": "$T1",
        "steps": [],
        "productionCost": {
          "include": [],
          "components": [
            { "id": "materialDirect", "base": { "accounts": ["5000"] } },
            { "id": "productionDirect", "base": { "accounts": ["6100"] } },
            { "id": "productionDepreciation", "base": { "accounts": ["6300"] } },
            { "id": "materialOverhead", "base": { "costCenters": ["MAT"] } },
            { "id": "productionOverhead", "base": { "costCenters": ["FERT"] } },
            { "id": "administration", "base": { "costCenters": ["VW"] } },
            { "id": "distribution", "base": { "costCenters": ["VT"] } }
          ]
        }
      },
      "expect": { "result": { "valid": true, "productionCostComponents": 7 } }
    },
    {
      "op": "runCosting",
      "input": { "tenant": "$T1", "fiscalYear": 2026, "period": 1 },
      "expect": { "result": { "runId": "$R1", "status": "draft", "version": 1 } }
    },
    {
      "op": "releaseCosting",
      "input": { "tenant": "$T1", "runId": "$R1" },
      "expect": { "result": { "status": "released" } }
    }
  ],
  "projections": [
    {
      "name": "productionCost",
      "params": { "tenant": "$T1", "runId": "$R1" },
      "expect": {
        "comment": "114.000,00 statt 126.000,00 — allein weil das us-Pack administration als Periodenaufwand führt",
        "total": "114000.00",
        "components": [
          { "id": "materialDirect", "amount": "50000.00", "treatment": "mandatory", "included": true },
          { "id": "productionDirect", "amount": "30000.00", "treatment": "mandatory", "included": true },
          { "id": "productionDepreciation", "amount": "8000.00", "treatment": "mandatory", "included": true },
          { "id": "materialOverhead", "amount": "5000.00", "treatment": "mandatory", "included": true },
          { "id": "productionOverhead", "amount": "21000.00", "treatment": "mandatory", "included": true },
          { "id": "administration", "amount": "12000.00", "treatment": "forbidden", "included": false },
          { "id": "distribution", "amount": "6000.00", "treatment": "forbidden", "included": false }
        ]
      }
    }
  ]
}
