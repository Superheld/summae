          { "account": "4930", "side": "debit", "money": { "amount": "20.00", "currency": "EUR" } },
          { "account": "1200", "side": "credit", "money": { "amount": "20.00", "currency": "EUR" } }
        ]
      },
      "expect": { "result": { "sequenceNumber": 2, "id": "$E2" } }
