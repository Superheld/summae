    {
      "op": "post",
      "input": {
        "entryDate": "2026-03-14",
        "voucherId": "$V3",
        "text": "offen seit 2 Tagen",
        "lines": [
          { "account": "4930", "side": "debit", "money": { "amount": "30.00", "currency": "EUR" } },
          { "account": "1200", "side": "credit", "money": { "amount": "30.00", "currency": "EUR" } }
        ]
      },
      "expect": { "result": { "sequenceNumber": 3, "id": "$E3" } }
    }
  ],
  "projections": [
    {
      "name": "unfinalizedEntries",
      "params": { "asOf": "2026-03-16" },
      "expect": {
        "asOf": "2026-03-16",
