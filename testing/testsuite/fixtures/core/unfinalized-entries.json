            "text": "offen seit 45 Tagen"
          },
          {
            "entryId": "$E3",
            "sequenceNumber": 3,
            "entryDate": "2026-03-14",
            "fiscalYear": 2026,
            "period": 3,
            "ageInDays": 2,
            "text": "offen seit 2 Tagen"
          }
        ]
      }
    },
    {
      "name": "unfinalizedEntries",
      "params": { "asOf": "2026-03-16", "olderThanDays": 30 },
      "expect": {
        "asOf": "2026-03-16",
