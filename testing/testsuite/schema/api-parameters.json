        "type": "integer",
        "required": true
      },
      "asOf": {
        "type": "date"
      }
    },
    "costAllocationSheet": {
      "runId": {
        "type": "string",
        "required": true
      },
      "fiscalYear": {
        "type": "integer",
        "$comment": "Must agree with the run named by runId, which already fixes it. Accepted and ignored before, so asking for one period and receiving another's numbers left no trace in the answer."
      },
      "period": {
        "type": "integer",
        "$comment": "Must agree with the run named by runId — see fiscalYear."
