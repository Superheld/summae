        "$comment": "The auditor's question is about ONE thing — this posting, this account, this partner — and until 0.13.0 the projection could only answer \"everything, by date\". Filtering outside the library means transporting the whole trail to do it, on the fastest-growing table in the system."
      },
      "objectId": {
        "type": "string"
      },
      "actor": {
        "type": "string"
      },
      "action": {
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "limit": {
        "type": "integer",
        "$comment": "Absent means everything from the offset on, exactly as on `journal`: a projection that invented a default page size would silently truncate a caller that never asked for pages."
      }
    },
    "unfinalizedEntries": {
      "asOf": {
        "type": "date"
      },
      "olderThanDays": {
        "type": "integer"
      },
      "fiscalYear": {
        "type": "integer"
      }
    },
    "personalDataDescription": {},
    "systemDescription": {},
    "auditTrailIntegrity": {},
    "gdpduExport": {
      "fiscalYear": {
        "type": "integer",
        "$comment": "Absent means the whole ledger. An audit usually asks for one year, and handing over more than was asked for is its own problem."
      },
      "mediaName": {
        "type": "string",
        "$comment": "The <Media><Name> in index.xml. Defaults to Disk1, which is what the standard's own examples use; set it when a data set spans several media."
      }
    },
    "accounts": {},
    "journal": {
      "fiscalYear": {
        "type": "integer",
        "required": true
      },
      "fromDate": {
        "type": "date"
      },
      "toDate": {
        "type": "date"
      },
      "offset": {
        "type": "integer"
      },
      "limit": {
        "type": "integer"
      }
    },
    "fiscalYears": {
      "fiscalYear": {
        "type": "integer"
      }
    },
