    },
    "cashJournal": {
      "fiscalYear": {
        "type": "integer",
        "required": true
      }
    },
    "journalExport": {
      "fiscalYear": {
        "type": "integer",
        "required": true
      },
      "format": {
        "type": "string",
        "$comment": "Exactly one value is valid: \"gobd-z3\". It selects nothing (there is no second journal format) but it guards the caller: an unknown value used to be ignored, so you received the Z3 stream under whatever label you had typed and could ship it to an auditor as something else. Absent means gobd-z3."
      }
    },
    "datevExport": {
      "kind": {
        "type": "string"
      },
      "fiscalYear": {
        "type": "integer"
