{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netmechanics.de/rechnungswesen/format/0.9/format.schema.json",
  "title": "Rechnungswesen-Datenformat v0.9",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,4})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    },
    "dimensionValue": {
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "taxTag": {
      "type": "object",
      "required": [
        "code",
        "appliedVersion"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "appliedVersion": {
          "$ref": "#/$defs/date"
        },
        "reportingKey": {
          "type": "string"
        },
        "baseMoney": {
          "$ref": "#/$defs/money"
        }
      },
      "additionalProperties": false
    },
    "entryLine": {
      "type": "object",
      "required": [
        "accountId",
        "side",
        "money"
      ],
      "properties": {
        "accountId": {
          "$ref": "#/$defs/uuid"
        },
        "side": {
          "enum": [
            "debit",
            "credit"
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionValue"
          }
        },
        "taxTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/taxTag"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "journalEntry": {
      "type": "object",
      "required": [
        "id",
        "sequenceNumber",
        "status",
        "entryDate",
        "voucherDate",
        "recordedAt",
        "periodRef",
        "voucherId",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "entered",
            "finalized"
          ]
        },
        "entryDate": {
          "$ref": "#/$defs/date"
        },
        "voucherDate": {
          "$ref": "#/$defs/date"
        },
        "recordedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "periodRef": {
          "type": "object",
          "required": [
            "fiscalYear",
            "period"
          ],
          "properties": {
            "fiscalYear": {
              "type": "integer"
            },
            "period": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "voucherId": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/entryLine"
          }
        },
        "reverses": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "settles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "openItemId",
              "money"
            ],
            "properties": {
              "openItemId": {
                "$ref": "#/$defs/uuid"
              },
              "money": {
                "$ref": "#/$defs/money"
              }
            },
            "additionalProperties": false
          }
        },
        "previousEntryHash": {
          "type": "string",
          "description": "reserviert, in v0.2 nicht belegt"
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "id",
        "number",
        "name",
        "type",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "asset",
            "liability",
            "equity",
            "expense",
            "revenue"
          ]
        },
        "subtype": {
          "enum": [
            "bank",
            "cash",
            "transit",
            "ar",
            "ap",
            "tax_in",
            "tax_out",
            "result_allocation",
            "fixed_asset",
            "opening_balance",
            "private"
          ],
          "description": "Kanonischer Subtyp — seit 0.9 ein GESCHLOSSENES Repertoire. Bis dahin ein freier String, und genau das war der Defekt: subtype ist das Feld, durch das der Kontenrahmen der Engine sagt, WAS ein Konto ist (welche Bewegung erfolgsneutral ist, welches Konto ein Steuerkonto ist und auf welcher Seite, welche Buchung eine Forderung er\u00f6ffnet). Ein Pack, das tax-out statt tax_out schrieb, erzeugte ein Konto, das annotiert aussah und inert war — die USt-Voranmeldung \u00fcbersprang es, und nichts in der Ausgabe sagte, dass ein Steuerkonto fehlte. Dieselbe Fehlerform, f\u00fcr die v0.8.0 die Steuermechanismen geschlossen hat (reverse-charge fiel auf normale USt zur\u00fcck) und f\u00fcr die PartnerKind geschlossen wurde (custommer war eine Partnerart wie jede andere). Acht der elf Werte liest die Engine und verzweigt darauf; fixed_asset, opening_balance und private sind Annotation, die jedes ausgelieferte Pack tr\u00e4gt und kein Code konsultiert — sie stehen im Repertoire, weil die Packs sie benutzen."
        },
        "status": {
          "enum": [
            "active",
            "locked"
          ]
        },
        "validFrom": {
          "$ref": "#/$defs/date"
        },
        "validTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "mappings": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "voucher": {
      "type": "object",
      "required": [
        "id",
        "voucherNumber",
        "voucherDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "voucherNumber": {
          "type": "string"
        },
        "voucherDate": {
          "$ref": "#/$defs/date"
        },
        "issuer": {
          "type": "string"
        },
        "totalMoney": {
          "$ref": "#/$defs/money"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "sha256"
            ],
            "properties": {
              "uri": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "recurring": {
          "type": "boolean"
        },
        "economicYear": {
          "type": "integer"
        },
        "supplierTaxationMethod": {
          "enum": [
            "accrual",
            "cash"
          ]
        },
        "serviceDate": {
          "$ref": "#/$defs/date"
        },
        "servicePeriod": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/date"
            },
            "to": {
              "$ref": "#/$defs/date"
            }
          },
          "additionalProperties": false
        },
        "partnerId": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "invoice_out",
            "invoice_in",
            "credit_note_out",
            "credit_note_in",
            "payment",
            "payroll",
            "internal",
            "opening"
          ]
        }
      },
      "additionalProperties": false
    },
    "partner": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "customer",
            "supplier",
            "both"
          ]
        },
        "vatId": {
          "type": "string"
        },
        "address": {
          "$comment": "The recommended postal shape, declared so an inventory can name it and an application can agree with the next one — NOT closed. `additionalProperties` stays open on purpose: books written before this shape existed may carry any key, and a schema that rejected them would make an export of lawful data invalid, which is a worse outcome than an undeclared key. `personalDataDescription.addressKeys` reports what a tenant actually holds, which is the question a declaration alone cannot answer. Deliberately no street/houseNumber split: it does not survive contact with addresses outside the German-speaking world, and `line1`/`line2` do.",
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "line2": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "$comment": "ISO 3166-1 alpha-2, uppercase — the same two letters the tax codes already speak.",
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "paymentTermsDays": {
          "type": "integer",
          "minimum": 0
        },
        "accountNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "active",
            "inactive"
          ]
        }
      },
      "additionalProperties": false
    },
    "openItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "originEntryId",
        "originLineIndex",
        "money"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "receivable",
            "payable"
          ]
        },
        "originEntryId": {
          "$ref": "#/$defs/uuid"
        },
        "originLineIndex": {
          "type": "integer",
          "minimum": 0
        },
        "partnerId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "remaining": {
          "$ref": "#/$defs/money"
        },
        "status": {
          "enum": [
            "open",
            "partially_settled",
            "settled",
            "cancelled"
          ]
        },
        "settlements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entryId",
              "money",
              "settledAt"
            ],
            "properties": {
              "entryId": {
                "$ref": "#/$defs/uuid"
              },
              "money": {
                "$ref": "#/$defs/money"
              },
              "settledAt": {
                "$ref": "#/$defs/date"
              },
              "cause": {
                "enum": [
                  "payment",
                  "cancellation"
                ]
              },
              "difference": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "money",
                      "kind"
                    ],
                    "properties": {
                      "money": {
                        "$ref": "#/$defs/money"
                      },
                      "kind": {
                        "enum": [
                          "discount",
                          "bad_debt",
                          "minor"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Offener Posten. `remaining`/`status` sind abgeleitet (money minus Ausgleiche), nie Wahrheit — wie Salden. `settlements[].cause` trennt Zahlung von Storno (v0.6/IMPL-008): `cancellation` ist kein Geldfluss und zählt bei Ist-Versteuerung nicht als Vereinnahmung."
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "chartOfAccounts",
        "taxCodes",
        "defaults"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "chartOfAccounts": {
          "type": "string"
        },
        "taxCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object"
        },
        "packPolicy": {
          "$ref": "#/$defs/packPolicy"
        }
      },
      "additionalProperties": false
    },
    "packPolicy": {
      "type": "object",
      "properties": {
        "roundingMode": {
          "enum": [
            "halfUpAwayFromZero",
            "halfEven"
          ]
        },
        "taxRoundingGranularity": {
          "enum": [
            "perVoucher",
            "perLine"
          ]
        },
        "currencyScale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "vatPeriods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Die Meldefenster, die diese Jurisdiktion kennt (SPEC-016). Fehlend = Substrat-Default [monthly, quarterly, yearly] — ein Default, keine Definition: welche Fenster es gibt, beantworten Jurisdiktionen verschieden (Irland meldet zweimonatlich), und eine geschlossene Liste im jurisdiktionsfreien Kern wäre eine Behauptung, die der Kern nicht aufstellen darf. Das erste Element ist zugleich der Default für ein Profil ohne vatPeriod."
        }
      },
      "additionalProperties": false,
      "description": "Pack-Policy-Parameter (v0.6); fehlend = DE-Default {halfUpAwayFromZero, perVoucher, 2}"
    },
    "depreciationData": {
      "type": "object",
      "properties": {
        "gwgThresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validFrom",
              "validTo",
              "immediateMax"
            ],
            "properties": {
              "validFrom": {
                "$ref": "#/$defs/date"
              },
              "validTo": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "immediateMax": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,4})?$"
              },
              "poolMin": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d{1,4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolMax": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d{1,4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolYears": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolReducedOnDisposal": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolProRataInFirstYear": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "poolMax": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "poolMax"
                  ]
                },
                "then": {
                  "required": [
                    "poolYears",
                    "poolReducedOnDisposal",
                    "poolProRataInFirstYear"
                  ],
                  "properties": {
                    "poolYears": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "poolReducedOnDisposal": {
                      "type": "boolean"
                    },
                    "poolProRataInFirstYear": {
                      "type": "boolean"
                    }
                  }
                }
              }
            ],
            "description": "Sammelposten/Pool: wer eine Pool-Spanne aufmacht (poolMin/poolMax), muss die Auflösungsdauer angeben (poolYears), sagen, ob ein Abgang den Pool vermindert (poolReducedOnDisposal), UND ob das erste Jahr zeitanteilig gekürzt wird (poolProRataInFirstYear) — sonst erbt jede Jurisdiktion still die deutschen Regeln (SPEC-004, IMPL-019). Deutschland: 5 Jahre, Abgang vermindert NICHT, erstes Jahr NICHT gekürzt (§6 Abs. 2a EStG — Auflösung im Wirtschaftsjahr der Bildung und den folgenden vier zu je einem Fünftel). UK/Australien: Abgänge werden dem Pool entnommen — dieselbe Weiche, andere Antwort."
          }
        },
        "usefulLife": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assetClass",
              "months"
            ],
            "properties": {
              "assetClass": {
                "type": "string"
              },
              "months": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "decliningBalance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validFrom",
              "validTo",
              "factor",
              "maxRate"
            ],
            "properties": {
              "validFrom": {
                "$ref": "#/$defs/date"
              },
              "validTo": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "factor": {
                "type": "integer",
                "minimum": 1
              },
              "maxRate": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,4})?$"
              },
              "assetClasses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "description": "Anlageklassen, für die dieser Eintrag gilt. Fehlt das Feld, gilt der Eintrag für jede Klasse. Ein klassenspezifischer Eintrag schlägt einen allgemeinen, unabhängig von der Reihenfolge in der Datei — nötig, weil zwei Regime gleichzeitig in Kraft sein können: Deutschland lässt für bewegliche Wirtschaftsgüter (§ 7 Abs. 2 EStG) und für neue Wohngebäude (§ 7 Abs. 5a EStG) über sich überlappende Fenster degressiv abschreiben, zu verschiedenen Sätzen."
              }
            },
            "additionalProperties": false,
            "description": "Degressive AfA: Satz = min(factor × linearer Satz, maxRate), jeweils vom Restbuchwert, mit automatischem Wechsel auf linear sobald linear über die Restnutzungsdauer mehr ergibt. Die Mechanik ist Kern und wird geteilt; Faktor, Deckel, Gültigkeitsfenster und Klassenzuschnitt sind Pack-Daten, weil genau sie sich unterscheiden — Deutschland: bewegliche Wirtschaftsgüter, Anschaffung 01.07.2025–31.12.2027, Faktor 3, höchstens 30 % (§ 7 Abs. 2 EStG); für neue Wohngebäude gilt dieselbe Mechanik mit anderem Satz und eigenem Fenster (§ 7 Abs. 5a EStG). Fehlt für ein Anschaffungsdatum und eine Klasse eine Regel, ist die Wahl der Methode E_PACK_INCOHERENT statt eines geratenen Satzes."
          }
        },
        "specialDepreciation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validFrom",
              "validTo",
              "rate",
              "years"
            ],
            "properties": {
              "validFrom": {
                "$ref": "#/$defs/date"
              },
              "validTo": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rate": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,4})?$"
              },
              "years": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "description": "Zusätzliche Abschreibung NEBEN der planmäßigen (kein AfA-Verfahren): ein Anteil `rate` der Anschaffungskosten, frei über `years` Jahre ab dem Anschaffungsjahr verteilbar. Der planmäßige Plan läuft währenddessen unverändert auf der ursprünglichen Bemessungsgrundlage weiter; nach Ablauf des Zeitraums verteilt der Kern den Restwert auf die Restnutzungsdauer. Deutschland: §7g Abs. 5 EStG, 20 % bis 2023, 40 % ab 2024, fünf Jahre. Ob die Voraussetzungen vorliegen (Gewinngrenze, betriebliche Nutzung), kann eine Buchhaltungsbibliothek nicht wissen — das entscheidet die App, der Kern prüft nur Budget und Zeitfenster."
        }
      },
      "additionalProperties": false,
      "description": "data eines depreciation-Moduls (v0.6): GWG-/de-minimis-Grenzen + Nutzungsdauern. Die Mechanik (linear und degressiv, pro rata, Methodenwechsel) ist Kern; hier stehen nur Daten."
    },
    "module": {
      "type": "object",
      "required": [
        "formatVersion",
        "id",
        "kind",
        "version",
        "contributes",
        "data"
      ],
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "accounts",
            "tax",
            "mapping",
            "depreciation",
            "policy",
            "assetAccounts",
            "productionCost",
            "constraint",
            "resultAppropriation",
            "legalForms",
            "inventory",
            "provisions"
          ]
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "contributes": {
          "type": "array",
          "items": {
            "enum": [
              "accounts",
