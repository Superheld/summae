{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netmechanics.de/rechnungswesen/format/0.6/format.schema.json",
  "title": "Rechnungswesen-Datenformat v0.6",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,4})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    },
    "dimensionValue": {
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "taxTag": {
      "type": "object",
      "required": [
        "code",
        "appliedVersion"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "appliedVersion": {
          "$ref": "#/$defs/date"
        },
        "reportingKey": {
          "type": "string"
        },
        "baseMoney": {
          "$ref": "#/$defs/money"
        }
      },
      "additionalProperties": false
    },
    "entryLine": {
      "type": "object",
      "required": [
        "accountId",
        "side",
        "money"
      ],
      "properties": {
        "accountId": {
          "$ref": "#/$defs/uuid"
        },
        "side": {
          "enum": [
            "debit",
            "credit"
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionValue"
          }
        },
        "taxTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/taxTag"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "journalEntry": {
      "type": "object",
      "required": [
        "id",
        "sequenceNumber",
        "status",
        "entryDate",
        "voucherDate",
        "recordedAt",
        "periodRef",
        "voucherId",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "entered",
            "finalized"
          ]
        },
        "entryDate": {
          "$ref": "#/$defs/date"
        },
        "voucherDate": {
          "$ref": "#/$defs/date"
        },
        "recordedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "periodRef": {
          "type": "object",
          "required": [
            "fiscalYear",
            "period"
          ],
          "properties": {
            "fiscalYear": {
              "type": "integer"
            },
            "period": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "voucherId": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/entryLine"
          }
        },
        "reverses": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "settles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "openItemId",
              "money"
            ],
            "properties": {
              "openItemId": {
                "$ref": "#/$defs/uuid"
              },
              "money": {
                "$ref": "#/$defs/money"
              }
            },
            "additionalProperties": false
          }
        },
        "previousEntryHash": {
          "type": "string",
          "description": "reserviert, in v0.2 nicht belegt"
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "id",
        "number",
        "name",
        "type",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "asset",
            "liability",
            "equity",
            "expense",
            "revenue"
          ]
        },
        "subtype": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "locked"
          ]
        },
        "validFrom": {
          "$ref": "#/$defs/date"
        },
        "validTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "mappings": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "voucher": {
      "type": "object",
      "required": [
        "id",
        "voucherNumber",
        "voucherDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "voucherNumber": {
          "type": "string"
        },
        "voucherDate": {
          "$ref": "#/$defs/date"
        },
        "issuer": {
          "type": "string"
        },
        "totalMoney": {
          "$ref": "#/$defs/money"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "sha256"
            ],
            "properties": {
              "uri": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "recurring": {
          "type": "boolean"
        },
        "economicYear": {
          "type": "integer"
        },
        "supplierTaxationMethod": {
          "enum": [
            "accrual",
            "cash"
          ]
        },
        "serviceDate": {
          "$ref": "#/$defs/date"
        },
        "servicePeriod": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/date"
            },
            "to": {
              "$ref": "#/$defs/date"
            }
          },
          "additionalProperties": false
        },
        "partnerId": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "invoice_out",
            "invoice_in",
            "credit_note_out",
            "credit_note_in",
            "payment",
            "payroll",
            "internal",
            "opening"
          ]
        }
      },
      "additionalProperties": false
    },
    "partner": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "customer",
            "supplier",
            "both"
          ]
        },
        "vatId": {
          "type": "string"
        },
        "address": {
          "type": "object"
        },
        "paymentTermsDays": {
          "type": "integer",
          "minimum": 0
        },
        "accountIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      },
      "additionalProperties": false
    },
    "openItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "originEntryId",
        "originLineIndex",
        "money"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "receivable",
            "payable"
          ]
        },
        "originEntryId": {
          "$ref": "#/$defs/uuid"
        },
        "originLineIndex": {
          "type": "integer",
          "minimum": 0
        },
        "partnerId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "remaining": {
          "$ref": "#/$defs/money"
        },
        "status": {
          "enum": [
            "open",
            "partially_settled",
            "settled",
            "cancelled"
          ]
        },
        "settlements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entryId",
              "money",
              "settledAt"
            ],
            "properties": {
              "entryId": {
                "$ref": "#/$defs/uuid"
              },
              "money": {
                "$ref": "#/$defs/money"
              },
              "settledAt": {
                "$ref": "#/$defs/date"
              },
              "cause": {
                "enum": [
                  "payment",
                  "cancellation"
                ]
              },
              "difference": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "money",
                      "kind"
                    ],
                    "properties": {
                      "money": {
                        "$ref": "#/$defs/money"
                      },
                      "kind": {
                        "enum": [
                          "discount",
                          "bad_debt",
                          "minor"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Offener Posten. `remaining`/`status` sind abgeleitet (money minus Ausgleiche), nie Wahrheit — wie Salden. `settlements[].cause` trennt Zahlung von Storno (v0.6/IMPL-008): `cancellation` ist kein Geldfluss und zählt bei Ist-Versteuerung nicht als Vereinnahmung."
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "chartOfAccounts",
        "taxCodes",
        "defaults"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "chartOfAccounts": {
          "type": "string"
        },
        "taxCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object"
        },
        "packPolicy": {
          "$ref": "#/$defs/packPolicy"
        }
      },
      "additionalProperties": false
    },
    "packPolicy": {
      "type": "object",
      "properties": {
        "roundingMode": {
          "enum": [
            "halfUpAwayFromZero",
            "halfEven"
          ]
        },
        "taxRoundingGranularity": {
          "enum": [
            "perVoucher",
            "perLine"
          ]
        },
        "currencyScale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "additionalProperties": false,
      "description": "Pack-Policy-Parameter (v0.6); fehlend = DE-Default {halfUpAwayFromZero, perVoucher, 2}"
    },
    "depreciationData": {
      "type": "object",
      "properties": {
        "gwgThresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validFrom",
              "validTo",
              "immediateMax"
            ],
            "properties": {
              "validFrom": {
                "$ref": "#/$defs/date"
              },
              "validTo": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "immediateMax": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,4})?$"
              },
              "poolMin": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d{1,4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolMax": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d{1,4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolYears": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolReducedOnDisposal": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "poolProRataInFirstYear": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "poolMax": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "poolMax"
                  ]
                },
                "then": {
                  "required": [
                    "poolYears",
                    "poolReducedOnDisposal",
                    "poolProRataInFirstYear"
                  ],
                  "properties": {
                    "poolYears": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "poolReducedOnDisposal": {
                      "type": "boolean"
                    },
                    "poolProRataInFirstYear": {
                      "type": "boolean"
                    }
                  }
                }
              }
            ],
            "description": "Sammelposten/Pool: wer eine Pool-Spanne aufmacht (poolMin/poolMax), muss die Auflösungsdauer angeben (poolYears), sagen, ob ein Abgang den Pool vermindert (poolReducedOnDisposal), UND ob das erste Jahr zeitanteilig gekürzt wird (poolProRataInFirstYear) — sonst erbt jede Jurisdiktion still die deutschen Regeln (SPEC-004, IMPL-019). Deutschland: 5 Jahre, Abgang vermindert NICHT, erstes Jahr NICHT gekürzt (§6 Abs. 2a EStG — Auflösung im Wirtschaftsjahr der Bildung und den folgenden vier zu je einem Fünftel). UK/Australien: Abgänge werden dem Pool entnommen — dieselbe Weiche, andere Antwort."
          }
        },
        "usefulLife": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assetClass",
              "months"
            ],
            "properties": {
              "assetClass": {
                "type": "string"
              },
              "months": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "decliningBalance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validFrom",
              "validTo",
              "factor",
              "maxRate"
            ],
            "properties": {
              "validFrom": {
                "$ref": "#/$defs/date"
              },
              "validTo": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "factor": {
                "type": "integer",
                "minimum": 1
              },
              "maxRate": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,4})?$"
              },
              "assetClasses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "description": "Anlageklassen, für die dieser Eintrag gilt. Fehlt das Feld, gilt der Eintrag für jede Klasse. Ein klassenspezifischer Eintrag schlägt einen allgemeinen, unabhängig von der Reihenfolge in der Datei — nötig, weil zwei Regime gleichzeitig in Kraft sein können: Deutschland lässt für bewegliche Wirtschaftsgüter (§ 7 Abs. 2 EStG) und für neue Wohngebäude (§ 7 Abs. 5a EStG) über sich überlappende Fenster degressiv abschreiben, zu verschiedenen Sätzen."
              }
            },
            "additionalProperties": false,
            "description": "Degressive AfA: Satz = min(factor × linearer Satz, maxRate), jeweils vom Restbuchwert, mit automatischem Wechsel auf linear sobald linear über die Restnutzungsdauer mehr ergibt. Die Mechanik ist Kern und wird geteilt; Faktor, Deckel, Gültigkeitsfenster und Klassenzuschnitt sind Pack-Daten, weil genau sie sich unterscheiden — Deutschland: bewegliche Wirtschaftsgüter, Anschaffung 01.07.2025–31.12.2027, Faktor 3, höchstens 30 % (§ 7 Abs. 2 EStG); für neue Wohngebäude gilt dieselbe Mechanik mit anderem Satz und eigenem Fenster (§ 7 Abs. 5a EStG). Fehlt für ein Anschaffungsdatum und eine Klasse eine Regel, ist die Wahl der Methode E_PACK_INCOHERENT statt eines geratenen Satzes."
          }
        }
      },
      "additionalProperties": false,
      "description": "data eines depreciation-Moduls (v0.6): GWG-/de-minimis-Grenzen + Nutzungsdauern. Die Mechanik (linear und degressiv, pro rata, Methodenwechsel) ist Kern; hier stehen nur Daten."
    },
    "module": {
      "type": "object",
      "required": [
        "formatVersion",
        "id",
        "kind",
        "version",
        "contributes",
        "data"
      ],
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "accounts",
            "tax",
            "mapping",
            "depreciation",
            "policy",
            "assetAccounts",
            "productionCost",
            "constraint"
          ]
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "contributes": {
          "type": "array",
          "items": {
            "enum": [
              "accounts",
              "taxCodes",
              "mappings",
              "assetAccounts",
              "policy",
              "depreciation",
              "productionCost",
              "constraint"
            ]
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "kleinste adressierbare Pack-Einheit (v0.6); data ist kind-abhängig (discriminated union per kind, hier offen gehalten, weil je kind verschieden)"
    },
    "packManifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "id",
        "version",
        "modules",
        "packPolicy"
      ],
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op",
              "ref"
            ],
            "properties": {
              "op": {
                "enum": [
                  "remove",
                  "replace"
                ]
              },
              "ref": {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "with": {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "taxCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object",
          "properties": {
            "taxationMethod": {
              "enum": [
                "accrual",
                "cash"
              ]
            },
            "smallBusiness": {},
            "vatPeriod": {
              "enum": [
                "monthly",
                "quarterly"
              ]
            }
          },
          "additionalProperties": false
        },
        "packPolicy": {
          "$ref": "#/$defs/packPolicy"
        }
      },
      "additionalProperties": false,
      "description": "benanntes, kuratiertes Modul-Bündel (v0.6); packPolicy ist Pflicht-Kopie (E-A)"
    },
    "mapping": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "positions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "balance-sheet",
            "income-statement",
            "cash-basis-categories"
          ]
        },
        "version": {
          "type": "string"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingPosition"
          }
        }
      },
      "additionalProperties": false
    },
    "mappingPosition": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "side": {
          "enum": [
            "assets",
            "liabilitiesAndEquity"
          ],
          "description": "nur am Wurzelknoten einer balance-sheet-Mapping; bestimmt Aktiv-/Passivseite (v0.5/SPEC-007)"
        },
        "includesNetIncome": {
          "type": "boolean"
        },
        "includeNonCash": {
          "type": "boolean",
          "description": "only meaningful on a cash-basis-categories mapping leaf; non-cash postings (e.g. depreciation) count without a cash flow (R7)"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "numbers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingPosition"
          }
        }
      },
      "additionalProperties": false
    },
    "auditRecord": {
      "type": "object",
      "required": [
        "id",
        "at",
        "actor",
        "objectType",
        "objectId",
        "action",
        "changes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "actor": {
          "type": "string"
        },
        "objectType": {
          "type": "string"
        },
        "objectId": {
          "$ref": "#/$defs/uuid"
        },
        "action": {
          "type": "string"
        },
        "changes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {},
              "to": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "tenantId",
        "tenantName",
        "baseCurrency",
        "exportedAt",
        "streams",
        "hashAlgorithm",
        "contentHashes"
      ],
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantName": {
          "type": "string"
        },
        "baseCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "exportedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "enthaltene Objektströme; auditLog ist immer dabei (v0.5/SPEC-005)"
        },
        "hashAlgorithm": {
          "type": "string",
          "const": "sha256"
        },
        "contentHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "productionCostData": {
      "type": "object",
      "required": [
        "treatments"
      ],
      "properties": {
        "treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "treatment"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "treatment": {
                "enum": [
                  "mandatory",
                  "optional",
                  "forbidden"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "description": "data eines productionCost-Moduls (v0.6): je Kostenbestandteil, ob er in die Herstellungskosten MUSS (mandatory), DARF (optional, Wahlrecht des Bilanzierenden) oder NICHT DARF (forbidden). Die Summierung ist Kern-Mechanik und für jede Jurisdiktion dieselbe; diese Tabelle ist genau der Teil, der sich unterscheidet — Deutschland § 255 Abs. 2 HGB (Material- und Fertigungsgemeinkosten sowie fertigungsbedingter Werteverzehr Pflicht, allgemeine Verwaltung und freiwillige Sozialleistungen Wahlrecht, Forschung und Vertrieb verboten) gegen US-GAAP ASC 330 (full absorption, allgemeine Verwaltung dagegen Periodenaufwand). Ein Bestandteil, den die Tabelle nicht führt, ist E_PACK_INCOHERENT statt still mitgezählt oder still weggelassen — beides verschöbe die Bilanz."
    },
    "constraintData": {
      "type": "object",
      "required": [
        "dimensionRules"
      ],
      "properties": {
        "dimensionRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "accountRange",
              "requiredDimension"
            ],
            "properties": {
              "accountRange": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "requiredDimension": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "description": "data eines constraint-Moduls (v0.6) — der Stecker der dritten Politiksorte. Heute genau ein Prädikat: dimensionRules sagt, welche Konten nicht ohne welche Dimension bebucht werden dürfen (Kontonummern-Bereich einschließlich, Vergleich über Unicode-Codepoints). Die DIMENSIONSTYPEN und -WERTE selbst bleiben Mandanten-Stammdaten (defineDimensionType/defineDimensionValue) — eine Jurisdiktion hat keine Meinung darüber, wie ein Unternehmen seine Kostenstellen nennt; welche Buchung ohne Zuordnung unzulässig ist, kann dagegen Regel sein. Mehrere constraint-Module addieren sich, statt einander zu ersetzen: sonst wäre die Modulreihenfolge im Manifest bedeutungstragend."
    }
  }
}
