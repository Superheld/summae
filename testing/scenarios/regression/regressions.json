{
  "id": "regressions",
  "description": "Regression guard: two fiscal years, plus the input-validation defects found by probing the CLI with wrong data. Every step here failed before its fix.",
  "init": {
    "pack": "de",
    "currency": "EUR",
    "firstFiscalYear": 2026
  },
  "expect": {
    "initialized": true,
    "created.accounts": 41,
    "created.fiscalYears": 1
  },
  "steps": [
    {
      "name": "NF-011: an invented taxTag on `post` must not reach the journal — `postVoucher` always went through the tax registry, the direct `post` path did not",
      "op": "createVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "X-1",
          "voucherDate": "2026-03-05"
        }
      },
      "capture": {
        "probeVoucher": "id"
      },
      "expect": {
        "voucherNumber": "X-1"
      }
    },
    {
      "name": "NF-011: fabricated tax code MADEUP with reporting key 4711 — used to be booked and then appeared as a line of the VAT return",
      "op": "post",
      "input": {
        "voucherId": "$probeVoucher",
        "entryDate": "2026-03-05",
        "text": "forged tax tag",
        "lines": [
          {
            "account": "1200",
            "side": "debit",
            "money": {
              "amount": "1.00",
              "currency": "EUR"
            },
            "taxTag": {
              "code": "MADEUP",
              "appliedVersion": "1999-01-01",
              "reportingKey": "4711",
              "baseMoney": {
                "amount": "999999.00",
                "currency": "EUR"
              }
            }
          },
          {
            "account": "1400",
            "side": "credit",
            "money": {
              "amount": "1.00",
              "currency": "EUR"
            }
          }
        ]
      },
      "expectError": "E_TAXCODE_UNKNOWN",
      "expectExitCode": 32
    },
    {
      "name": "a taxTag naming a REGISTERED code still posts — the guard checks the registry, it does not forbid tags",
      "op": "post",
      "input": {
        "voucherId": "$probeVoucher",
        "entryDate": "2026-03-05",
        "text": "legitimate tax tag",
        "lines": [
          {
            "account": "1200",
            "side": "debit",
            "money": {
              "amount": "1.00",
              "currency": "EUR"
            },
            "taxTag": {
              "code": "USt19",
              "appliedVersion": "2024-01-01",
              "reportingKey": "81",
              "baseMoney": {
                "amount": "1.00",
                "currency": "EUR"
              }
            }
          },
          {
            "account": "1400",
            "side": "credit",
            "money": {
              "amount": "1.00",
              "currency": "EUR"
            }
          }
        ]
      },
      "expect": {
        "sequenceNumber": 1,
        "lines[0].taxTag.code": "USt19"
      }
    },
    {
      "name": "year one: an outgoing invoice",
      "op": "postVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "AR-26",
          "voucherDate": "2026-06-10"
        },
        "entryDate": "2026-06-10",
        "text": "invoice 2026",
        "taxCode": "USt19",
        "direction": "output",
        "netLines": [
          {
            "account": "4000",
            "money": {
              "amount": "1000.00",
              "currency": "EUR"
            }
          }
        ],
        "counterAccount": "1400"
      },
      "expect": {
        "grossTotal.amount": "1190.00"
      }
    },
    {
      "name": "open a second fiscal year — no scenario spanned two years before, which is why the cross-year defects were invisible",
      "op": "createFiscalYear",
      "input": {
        "year": 2027,
        "start": "2027-01-01",
        "end": "2027-12-31"
      },
      "expect": {
        "year": 2027,
        "periodCount": 12
      }
    },
    {
      "name": "year two: a second invoice",
      "op": "postVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "AR-27",
          "voucherDate": "2027-06-10"
        },
        "entryDate": "2027-06-10",
        "text": "invoice 2027",
        "taxCode": "USt19",
        "direction": "output",
        "netLines": [
          {
            "account": "4000",
            "money": {
              "amount": "2000.00",
              "currency": "EUR"
            }
          }
        ],
        "counterAccount": "1400"
      },
      "expect": {
        "grossTotal.amount": "2380.00",
        "entry.periodRef.fiscalYear": 2027
      }
    },
    {
      "name": "NF-012: balanceSheet must SEE fiscalYear — it used to ignore the parameter and return the whole journal, so 2026 and 2027 came out byte-identical",
      "report": "balanceSheet",
      "params": {
        "fiscalYear": 2026,
        "mapping": "de-bilanz"
      },
      "expect": {
        "assetsTotal": "1190.00",
        "liabilitiesAndEquityTotal": "1190.00"
      }
    },
    {
      "name": "NF-012: the second year differs, and the sheet still balances (cumulative — summae writes no closing entries, so a prior year's result stays in the result position)",
      "report": "balanceSheet",
      "params": {
        "fiscalYear": 2027,
        "mapping": "de-bilanz"
      },
      "expect": {
        "assetsTotal": "3570.00",
        "liabilitiesAndEquityTotal": "3570.00"
      }
    },
    {
      "name": "trialBalance is per fiscal year and unaffected: income restarts each year (G1)",
      "report": "trialBalance",
      "params": {
        "fiscalYear": 2027
      },
      "expect": {
        "rows[3].account": "4000",
        "rows[3].balance": "-2000.00"
      }
    },
    {
      "name": "NF-010: an amount in exponent notation is not in the data format — it used to book 1.5 sextillion without complaint",
      "op": "post",
      "input": {
        "voucherId": "$probeVoucher",
        "entryDate": "2026-03-05",
        "lines": [
          {
            "account": "1200",
            "side": "debit",
            "money": {
              "amount": "1.5e+21",
              "currency": "EUR"
            }
          },
          {
            "account": "4000",
            "side": "credit",
            "money": {
              "amount": "1.5e+21",
              "currency": "EUR"
            }
          }
        ]
      },
      "expectError": "E_ENTRY_INVALID_AMOUNT",
      "expectExitCode": 14
    },
    {
      "name": "NF-010: a leading plus is not in the data format either — PHP used to accept it, Node did not",
      "op": "post",
      "input": {
        "voucherId": "$probeVoucher",
        "entryDate": "2026-03-05",
        "lines": [
          {
            "account": "1200",
            "side": "debit",
            "money": {
              "amount": "+10.00",
              "currency": "EUR"
            }
          },
          {
            "account": "4000",
            "side": "credit",
            "money": {
              "amount": "+10.00",
              "currency": "EUR"
            }
          }
        ]
      },
      "expectError": "E_ENTRY_INVALID_AMOUNT",
      "expectExitCode": 14
    },
    {
      "name": "NF-009: a year below 0100 is a valid calendar date in both languages now — it fails on the fiscal year, not on the date format",
      "op": "createVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "OLD",
          "voucherDate": "0050-06-15"
        }
      },
      "expect": {
        "voucherNumber": "OLD"
      }
    },
    {
      "name": "NF-013: a wrong `direction` used to fall through to \"output\" — an incoming invoice with \"Input\" (capital I) booked FULLY INVERTED: expense credited, payable debited",
      "op": "postVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "ER-BAD",
          "voucherDate": "2026-03-12"
        },
        "entryDate": "2026-03-12",
        "taxCode": "VSt19",
        "direction": "Input",
        "netLines": [
          {
            "account": "6000",
            "money": {
              "amount": "200.00",
              "currency": "EUR"
            }
          }
        ],
        "counterAccount": "3000"
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    },
    {
      "name": "the documented default still works: no `direction` at all means \"output\"",
      "op": "postVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "AR-DEF",
          "voucherDate": "2026-03-13"
        },
        "entryDate": "2026-03-13",
        "taxCode": "USt19",
        "netLines": [
          {
            "account": "4000",
            "money": {
              "amount": "100.00",
              "currency": "EUR"
            }
          }
        ],
        "counterAccount": "1400"
      },
      "expect": {
        "grossTotal.amount": "119.00",
        "entry.lines[0].side": "debit",
        "entry.lines[0].account": "1400"
      }
    },
    {
      "name": "a correct lower-case \"input\" still books an incoming invoice the right way round",
      "op": "postVoucher",
      "input": {
        "voucher": {
          "voucherNumber": "ER-OK",
          "voucherDate": "2026-03-14"
        },
        "entryDate": "2026-03-14",
        "taxCode": "VSt19",
        "direction": "input",
        "netLines": [
          {
            "account": "6000",
            "money": {
              "amount": "200.00",
              "currency": "EUR"
            }
          }
        ],
        "counterAccount": "3000"
      },
      "expect": {
        "grossTotal.amount": "238.00",
        "entry.lines[0].account": "3000",
        "entry.lines[0].side": "credit",
        "entry.lines[1].account": "6000",
        "entry.lines[1].side": "debit"
      }
    },
    {
      "name": "NF-006: cashBasisReport without `year` used to crash in Node and return an empty report in PHP — now both name the missing parameter",
      "report": "cashBasisReport",
      "params": {
        "fiscalYear": 2026
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    },
    {
      "name": "NF-007: a mapping that is not loaded is a caller mistake, not an overlap",
      "report": "incomeStatement",
      "params": {
        "fiscalYear": 2026,
        "mapping": "does-not-exist"
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    },
    {
      "name": "cashBasisReport used to IGNORE an unknown mapping while the other two threw on the same value",
      "report": "cashBasisReport",
      "params": {
        "year": 2026,
        "mapping": "does-not-exist"
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    },
    {
      "name": "C-6: accountSheet without `fiscalYear` used to return an authoritative-looking empty ledger, account name and all",
      "report": "accountSheet",
      "params": {
        "account": "1200"
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    },
    {
      "name": "...and a numerically typed `account` is a caller mistake too, not an unknown account",
      "report": "accountSheet",
      "params": {
        "account": 1200,
        "fiscalYear": 2026
      },
      "expectError": "E_INPUT_INVALID",
      "expectExitCode": 45
    }
  ]
}
